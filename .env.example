# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# 'inline' = run BullMQ workers in the API process (dev/single node).
# 'separate' = API only; run workers via `npm run start:worker` on their own dyno.
WORKER_MODE=inline
# Comma-separated browser origins allowed for CORS (e.g. the admin web panel).
# Native mobile clients send no Origin and are always allowed. In production an
# empty value denies all browser cross-origin requests (fail closed).
# Example: CORS_ORIGINS=https://admin.eyesection.com,https://staging-admin.eyesection.com
CORS_ORIGINS=
# Days a never-upgraded anonymous user (EB-13) is kept before daily cleanup.
ANON_TTL_DAYS=30

# ── MongoDB ────────────────────────────────────────────
MONGODB_URI=

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
# Separate secret for the admin panel (EB-12)
ADMIN_JWT_SECRET=

# ── Redis (BullMQ) ─────────────────────────────────────
REDIS_URL=

# ── AWS S3 ─────────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── OpenAI (vision appearance rating) ──────────────────
OPENAI_API_KEY=
# Vision model for the 3-vote ensemble. Default 'gpt-4o' (flagship multimodal,
# supports Structured Outputs); step down to 'gpt-4o-mini' for lower cost.
OPENAI_MODEL=
# Text-only model for routine tips / AI chat (no vision needed). Default
# 'gpt-4o-mini' — the most cost-effective tier with Structured Outputs.
OPENAI_TEXT_MODEL=
# Optional ascending "a,b,c" cutoff overrides for the code-measured metrics,
# produced by `npm run calibrate:thresholds`. Leave empty to use the defaults.
DARK_CIRCLE_THRESHOLDS=
REDNESS_THRESHOLDS=
FINELINES_THRESHOLDS=
RADIANCE_THRESHOLDS=

# ── Firebase Admin ─────────────────────────────────────
# Verifies Google/Apple ID tokens on /auth/social and /auth/upgrade.
# Loader accepts EITHER a path to the JSON file OR the full JSON as a
# single-line string.
#   • Local dev:  ./firebase-service-account.json  (file on disk)
#   • Railway/prod: the file is git-ignored and won't exist on the box,
#     so paste the ENTIRE service-account JSON as ONE line here instead.
#     Generate: `node -e "console.log(JSON.stringify(require('./firebase-service-account.json')))"`
FIREBASE_SERVICE_ACCOUNT=

# ── RevenueCat ─────────────────────────────────────────
# Shared secret used to verify incoming webhook Authorization header
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat REST API key (admin re-sync, EB-12) — optional for now
REVENUECAT_API_KEY=

# ── Admin seed (EB-12) ─────────────────────────────────
# Used once by `npm run seed:admin` to create the first superadmin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
