# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# 'inline' = run BullMQ workers in the API process (dev/single node).
# 'separate' = API only; run workers via `npm run start:worker` on their own dyno.
WORKER_MODE=inline
# Scans processed at once by the analyze worker. Each scan = 3 parallel OpenAI
# vision calls, so peak OpenAI concurrency = ANALYZE_CONCURRENCY × 3. Keep that
# product under your OpenAI rate limit. Default 3.
ANALYZE_CONCURRENCY=10
# Fleet-wide cap (across all worker replicas, enforced via Redis) on scans the
# analyze queue processes per minute — protects the OpenAI budget/rate limit from
# a queue flood or over-scaled worker pool. Effective vision RPM ≈ this × 3.
# Set 0 to disable. Default 180.
ANALYZE_MAX_PER_MIN=180
# MongoDB pool + timeout tuning (per process). Driver default pool is 100, which
# across replicas can exhaust an Atlas connection cap; 20 is ample for
# ANALYZE_CONCURRENCY + HTTP. Defaults: pool 0-20, selection 10s, socket 45s.
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
# Comma-separated browser origins allowed for CORS (e.g. the admin web panel).
# Native mobile clients send no Origin and are always allowed. In production an
# empty value denies all browser cross-origin requests (fail closed).
# Example: CORS_ORIGINS=https://admin.eyesection.com,https://staging-admin.eyesection.com
CORS_ORIGINS=
# Days a never-upgraded anonymous user (EB-13) is kept before daily cleanup.
ANON_TTL_DAYS=30
# Max scans an UNAUTHENTICATED caller may run per rolling 24h, keyed by client IP
# (each scan fans out to several OpenAI vision calls). Set 0 to require an account
# before scanning. Default 3.
ANON_SCAN_DAILY_LIMIT=3
# Express trust-proxy setting — MUST match the number of reverse proxies in front
# of the app or req.ip (the rate-limit key) becomes spoofable via X-Forwarded-For.
# Integer = hop count (e.g. 1 behind a single load balancer); 'true'/'false' =
# trust all / none; or a subnet list. Default 1.
TRUST_PROXY=1

# ── MongoDB ────────────────────────────────────────────
MONGODB_URI=

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
# Separate secret for the admin panel (EB-12)
ADMIN_JWT_SECRET=

# ── Redis (BullMQ) ─────────────────────────────────────
REDIS_URL=

# ── AWS S3 ─────────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── OpenAI (vision appearance rating) ──────────────────
OPENAI_API_KEY=
# Vision model for the 3-vote ensemble. Default 'gpt-5.6-sol' (flagship
# multimodal, supports Structured Outputs); step down to 'gpt-5.6-terra' /
# 'gpt-5.6-luna' for lower cost.
OPENAI_MODEL=
# Text-only model for routine tips / AI chat (no vision needed). Default
# 'gpt-5.6-luna' — cost-efficient GPT-5.6 with Structured Outputs.
OPENAI_TEXT_MODEL=
# Optional ascending "a,b,c" cutoff overrides for the code-measured metrics,
# produced by `npm run calibrate:thresholds`. Leave empty to use the defaults.
DARK_CIRCLE_THRESHOLDS=
REDNESS_THRESHOLDS=
FINELINES_THRESHOLDS=
RADIANCE_THRESHOLDS=

# ── Firebase Admin ─────────────────────────────────────
# Verifies Google/Apple ID tokens on /auth/social and /auth/upgrade.
# Loader accepts EITHER a path to the JSON file OR the full JSON as a
# single-line string.
#   • Local dev:  ./firebase-service-account.json  (file on disk)
#   • Production: DO NOT ship the JSON file. Store the service-account JSON in a
#     secret manager (Railway/Cloud/Vault secret) and inject it here as ONE line.
#     A private-key file sitting in the container image/working tree is a leak
#     risk; the loader warns if it reads from a file path in production.
#     Generate the one-liner: `node -e "console.log(JSON.stringify(require('./firebase-service-account.json')))"`
FIREBASE_SERVICE_ACCOUNT=

# ── RevenueCat ─────────────────────────────────────────
# Shared secret used to verify incoming webhook Authorization header
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat REST API key (admin re-sync, EB-12) — optional for now
REVENUECAT_API_KEY=

# ── Admin seed (EB-12) ─────────────────────────────────
# Used once by `npm run seed:admin` to create the first superadmin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
